      "executable": false,
      "content": "{\n  \"name\": \"slugify-normalization\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"test\": \"node test/public.test.mjs\" }\n}\n"
    },
    {
      "path": "src/slugify.mjs",
      "encoding": "utf8",
      "executable": false,
      "content": "export function slugify(value) {\n  return value.trim().toLowerCase().replace(/\\s+/, '-')\n}\n"
    },
    {
      "path": "test/public.test.mjs",
      "encoding": "utf8",
      "executable": false,
      "content": "import assert from 'node:assert/strict'\nimport { slugify } from '../src/slugify.mjs'\n\nassert.equal(slugify('Hello, World'), 'hello-world')\n"
    }
  ]
