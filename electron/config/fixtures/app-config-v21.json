  },
  "mcpServers": [],
  "models": {
    "defaultModelProvider": "deepseek",
    "defaultModel": "fixture-main",
    "auxiliaryModelProvider": "auxiliary",
    "auxiliaryModel": "fixture-aux",
    "providers": [
      {
        "id": "deepseek",
        "label": "DeepSeek",
        "providerType": "deepseek.chat-completions",
        "revision": 3,
        "baseURL": "https://api.deepseek.com",
        "model": "fixture-main",
        "modelCatalog": [{ "id": "fixture-main" }],
        "modelOverrides": {
          "fixture-main": { "reasoningEfforts": ["high", "max"] }
        },
        "enabledModelIds": ["fixture-main"],
        "reasoning": "max",
        "apiKeyRef": "provider-key:main"
      },
      {
        "id": "auxiliary",
        "label": "Auxiliary",
        "providerType": "generic.responses",
        "revision": 5,
        "baseURL": "https://auxiliary.example/v1",
        "model": "fixture-aux",
        "modelCatalog": [{ "id": "fixture-aux" }],
        "modelOverrides": {
          "fixture-aux": { "reasoningEfforts": ["low", "medium"] }
        },
        "enabledModelIds": ["fixture-aux"],
        "reasoning": "low",
        "apiKeyRef": "provider-key:auxiliary"
      }
    ],
    "modelPool": {
      "entries": [
        {
          "id": "fixture-worker",
          "enabled": true,
          "providerId": "deepseek",
          "model": "fixture-main",
          "reasoning": "high"
        }
      ]
    }
  }
