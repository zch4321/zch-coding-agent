          "version": "2026-08-12.1"
        },
        "en-US": {
          "id": "orchestration.goal-continue.en-US",
          "version": "2026-08-12.1"
        }
      },
      "planStarted": {
        "zh-CN": {
          "id": "orchestration.plan-started.zh-CN",
          "version": "2026-08-12.1"
        },
        "en-US": {
          "id": "orchestration.plan-started.en-US",
