    "orchestration": {
      "goalStarted": {
        "zh-CN": {
          "id": "orchestration.goal-started.zh-CN",
          "version": "2026-08-12.1"
        },
        "en-US": {
          "id": "orchestration.goal-started.en-US",
          "version": "2026-08-12.1"
        }
      },
      "goalContinue": {
        "zh-CN": {
