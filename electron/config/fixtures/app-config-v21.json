{
  "schemaVersion": 21,
  "subagents": {
    "enabled": false,
    "workerTimeoutMs": 1800000,
    "maxAgentsPerSwarm": 10
  },
  "executionEnvironment": {
    "commandShell": "windows-powershell"
  },
  "permission": {
    "defaultMode": "readonly",
    "builtinPolicies": true,
    "rememberedRules": [],
    "sensitiveData": {
      "mode": "off",
      "pathGlobs": [],
      "contentPatterns": []
    }
  },
  "limits": {
    "maxConcurrentRuns": 16,
    "maxStepsPerRun": 0,
    "maxToolOutputBytes": 131072,
    "maxContextTokens": 256000,
    "maxAttachmentContextTokens": 64000,
    "autoCompactTriggerPercent": 80,
    "maxToolResultTokens": 64000,
    "tokenEstimation": {
      "mode": "conservative",
      "bytesPerToken": 3
    },
    "commandTimeoutMs": 120000,
    "readFileSourceBytes": 10000000,
    "readFileOutputBytes": 131072,
    "editableFileBytes": 10000000,
    "writeFileBytes": 262144,
    "patchBytes": 65536,
    "diffChars": 120000,
    "fileChangeHistoryBytes": 100000000,
    "approvalTimeoutMs": 600000,
    "autoApprovalTimeoutMs": 60000,
    "modelCatalogTimeoutMs": 15000,
    "terminalScrollbackBytes": 2000000,
    "fetchResponseBytes": 262144,
    "fetchTimeoutMs": 20000,
    "fetchMaxRedirects": 5
  },
  "logging": {
    "enabled": false,
    "retentionDays": 14,
    "maxTotalBytes": 500000000
  },
  "privacy": {},
  "workspace": {},
  "skills": {
    "enabled": true,
    "maxSummaryChars": 2000
  },
  "assistant": {
    "language": "zh-CN",
    "preferences": {
      "zh-CN": "",
      "en-US": ""
    }
  },
  "prompts": {
